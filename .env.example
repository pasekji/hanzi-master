# Příklad konfigurace pro server — zkopíruj na server jako /opt/hanzi-master/.env
# (chmod 600, nikdy necommituj). V compose je MONGODB_URI nastavena napevno
# na lokální mongo kontejner; přepiš jen když chceš externí Mongo.
# MONGODB_URI=mongodb://hanzi-master-mongo:27017/hanzi-master
# PORT=3000
# Bez MONGODB_URI běží server s lokálním JSON úložištěm (data/db.json) —
# užitečné pro lokální vývoj a testy.
